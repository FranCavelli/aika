---
// Esqueleto común: fuentes, carrito y navegación sin recarga entre páginas. El tema lo pone cada propuesta.
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import { cargarTienda, ruta } from '../lib/data';
const { tema, titulo = 'Aika Indu by Cande' } = Astro.props;
const { productos, config } = cargarTienda();
const datos = { productos, config };
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content="Aika Indu by Cande: ropa de mujer y hombre. Elegí online y coordiná por WhatsApp." />
  <link rel="icon" href={ruta('favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:opsz,wght@9..40,400..600&family=Gloock&family=Montserrat:wght@300;400;500;600&family=Mrs+Saint+Delafield&display=swap" rel="stylesheet" />
  <ClientRouter fallback="swap" />
</head>
<body data-tema={tema}>
  <slot />

  <a class="wsp-flotante" href={`https://wa.me/${(config.whatsapp || '').replace(/\D/g, '')}?text=${encodeURIComponent('¡Hola! Quiero hacer una consulta')}`} target="_blank" rel="noopener" aria-label="Chatear por WhatsApp" transition:persist="wsp">
    <span class="onda"></span><span class="onda"></span>
    <span class="wsp-btn"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.003 2.667C8.638 2.667 2.67 8.635 2.667 16a13.3 13.3 0 0 0 1.78 6.667L2.667 29.333l6.844-1.747A13.3 13.3 0 0 0 16 29.333h.003C23.368 29.333 29.333 23.365 29.337 16c.002-3.561-1.385-6.91-3.903-9.429A13.25 13.25 0 0 0 16.003 2.667m0 24.444h-.002a11.06 11.06 0 0 1-5.635-1.543l-.404-.24-4.188.982 1.118-3.966-.263-.421a11.05 11.05 0 0 1-1.691-5.923c.002-6.123 4.985-11.106 11.069-11.106a11 11 0 0 1 7.831 3.245 11 11 0 0 1 3.239 7.828c-.003 6.123-4.985 11.145-11.074 11.145m6.076-8.337c-.333-.167-1.972-.972-2.277-1.083s-.527-.167-.75.167-.861 1.083-1.056 1.306-.389.25-.722.083-1.407-.518-2.68-1.654c-.99-.884-1.66-1.976-1.854-2.309s-.021-.514.146-.68c.15-.149.333-.389.5-.583.167-.195.222-.333.333-.556.111-.222.055-.417-.028-.583-.083-.167-.75-1.806-1.027-2.473-.27-.65-.546-.561-.75-.572-.194-.01-.417-.012-.639-.012s-.584.083-.889.417c-.306.333-1.167 1.139-1.167 2.778 0 1.639 1.195 3.222 1.361 3.445.167.222 2.35 3.59 5.694 5.032.796.344 1.417.549 1.902.702.798.254 1.525.218 2.099.132.641-.096 1.972-.806 2.25-1.584.278-.778.278-1.444.194-1.584-.083-.139-.305-.222-.639-.389"/></svg></span>
  </a>
  <div class="velo" data-cerrar hidden transition:persist="velo"></div>


  <aside class="panel bolsa" id="bolsa" transition:persist="bolsa" aria-label="Tu bolsa" aria-hidden="true">
    <header class="bolsa-cab"><h2>Tu bolsa</h2><button class="cerrar" data-cerrar aria-label="Cerrar"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button></header>
    <p class="bolsa-envio"></p>
    <ul class="bolsa-items"></ul>
    <p class="bolsa-vacia">Tu bolsa está vacía. Elegí algo lindo del catálogo.</p>
    <footer class="bolsa-pie">
      <p class="bolsa-total"><span>Total</span><strong></strong></p>
      <a class="btn btn-lleno bolsa-wsp" target="_blank" rel="noopener">Pedir por WhatsApp</a>
      <p class="bolsa-nota">Te respondemos para coordinar pago y envío.</p>
    </footer>
  </aside>

  <script type="application/json" id="datos-tienda" set:html={JSON.stringify(datos)} />
  <script src="../scripts/tienda.ts"></script>
</body>
</html>
