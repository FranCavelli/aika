---
// Cabecera de la tienda: logo, menú y bolsa. En el inicio los links son anclas; en otras páginas vuelven al inicio.
import Logo from './Logo.astro';
import Ui from './Ui.astro';
import { ruta } from '../lib/data';
const { inicio = false } = Astro.props;
const a = (h: string) => inicio ? h : ruta(`/${h}`);
---
<header class="cab marco">
  <Logo tam={1.05} />
  <nav class="nav" aria-label="Principal"><a href={a('#lookbook')}>Lookbook</a><a href={a('#catalogo')}>Catálogo</a><a href={a('#sale')}>Sale</a></nav>
  <button class="icono-btn" data-abrir-bolsa aria-label="Abrir bolsa"><Ui n="bolsa" /><span class="contador" data-contador hidden>0</span></button>
</header>
<style>
  .cab{display:flex;align-items:center;justify-content:space-between;gap:24px;height:84px}
  .nav{display:none;gap:32px;font-size:.92rem}
  .nav a{text-decoration:none}
  .nav a:hover{color:var(--acento)}
  @media (min-width:800px){.nav{display:flex}}
</style>
