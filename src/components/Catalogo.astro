---
// Catálogo completo con filtros por categoría y por mujer/hombre.
import Producto from './Producto.astro';
import Ui from './Ui.astro';
import type { Producto as P, Categoria } from '../lib/data';
interface Props { productos: P[]; categorias: Categoria[]; moneda?: string; titulo?: string }
const { productos, categorias, moneda, titulo = 'Catálogo' } = Astro.props;
const hayHombre = productos.some(p => p.genero === 'Hombre');
---
<section class="catalogo" id="catalogo" data-catalogo>
  <div class="cat-cab">
    <h2>{titulo}</h2>
    <div class="cat-filtros">
      <details class="cat-menu" data-cat-menu>
        <summary><Ui n="filtro" /><span data-cat-actual>Categorías</span><Ui n="abajo" /></summary>
        <div class="cat-lista" role="group" aria-label="Categoría">
          <button data-filtro="cat:Todo" aria-pressed="true">Todo</button>
          {categorias.map(c => <button data-filtro={`cat:${c.nombre}`} aria-pressed="false">{c.nombre}</button>)}
        </div>
      </details>
      {hayHombre && (
        <div class="filtros" role="group" aria-label="Para">
          <button class="chip" data-filtro="gen:Todo" aria-pressed="true">Todos</button>
          <button class="chip" data-filtro="gen:Mujer" aria-pressed="false">Mujer</button>
          <button class="chip" data-filtro="gen:Hombre" aria-pressed="false">Hombre</button>
        </div>
      )}
    </div>
  </div>
  <div class="grilla">
    {productos.map(p => <Producto p={p} moneda={moneda} />)}
  </div>
  <p class="sin-resultados" data-sin-resultados hidden>No hay prendas con ese filtro por ahora.</p>
</section>
<style>
  .cat-cab{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-bottom:32px}
  .cat-cab h2{font-size:clamp(2rem,4vw,3rem)}
  .cat-filtros{display:flex;flex-wrap:wrap;gap:12px 28px}
  .cat-menu{position:relative}
  .cat-menu summary{display:flex;align-items:center;gap:10px;min-height:44px;padding:0 16px;border:1px solid transparent;border-radius:var(--radio);cursor:pointer;list-style:none;font-size:.9rem;transition:border-color .2s}
  .cat-menu summary::-webkit-details-marker{display:none}
  .cat-menu summary:hover,.cat-menu[open] summary{border-color:var(--tinta)}
  .cat-menu summary :global(svg){width:20px;height:20px}
  .cat-menu summary :global(svg:last-child){width:16px;height:16px;transition:transform .2s}
  .cat-menu[open] summary :global(svg:last-child){transform:rotate(180deg)}
  .cat-lista{position:absolute;right:0;top:calc(100% + 8px);z-index:20;display:flex;flex-direction:column;min-width:220px;padding:8px;background:var(--fondo);border:1px solid var(--linea);border-radius:var(--radio);box-shadow:0 12px 32px rgb(0 0 0 / .12)}
  .cat-lista button{min-height:40px;padding:0 12px;border:0;background:none;text-align:left;font-size:.9rem;border-radius:calc(var(--radio) / 2)}
  .cat-lista button:hover{background:color-mix(in srgb,var(--tinta) 8%,transparent)}
  .cat-lista button[aria-pressed="true"]{font-weight:600}
  .grilla{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 16px}
  @media (min-width:900px){.grilla{grid-template-columns:repeat(4,minmax(0,1fr));gap:48px 24px}}
</style>
