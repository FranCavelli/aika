---
import type { Producto } from '../lib/data';
import { precio, ruta } from '../lib/data';
import { muestra } from '../lib/colores';
interface Props { p: Producto; moneda?: string; carga?: 'lazy' | 'eager' }
const { p, moneda = '$', carga = 'lazy' } = Astro.props;
const agotado = p.stock <= 0;
// puntitos que avisan que hay más fotos (máximo 3); en los de una foto por color ya están las muestras de color
const puntos = p.fotosPorColor ? 0 : Math.min(p.imagenes.length, 3);
---
<a href={ruta(`/producto/${p.id}/`)} class:list={['prod', { 'prod-agotado': agotado }]} data-producto={p.id} data-cat={p.categoria} data-gen={p.genero}>
  <div class="prod-foto">
    {p.imagenes[0] ? <img src={p.imagenes[0]} alt={p.nombre} loading={carga} width="800" height="1000" /> : <span class="sin-foto">{p.nombre}</span>}
    {agotado ? <span class="prod-marca">AGOTADO</span>
      : p.descuento ? <span class="prod-marca oferta">-{p.descuento}%</span>
      : p.nuevo && <span class="prod-marca">NUEVO</span>}
    {puntos > 1 && <span class="prod-puntos" aria-label={`${p.imagenes.length} fotos`}>{Array.from({ length: puntos }, () => <span></span>)}</span>}
  </div>
  <p class="prod-nombre">{p.nombre}</p>
  <p class="prod-precio">
    {p.precioAnterior ? <><span class="rebajado">{precio(p.precio, moneda)}</span><s>{precio(p.precioAnterior, moneda)}</s></> : <span>{precio(p.precio, moneda)}</span>}
  </p>
  {p.colores.length > 1 && <span class="prod-colores">{p.colores.map(c => <span class="punto" style={`--c:${muestra(c)}`} title={c}></span>)}{p.colores.length > 4 && <span class="mas-colores">+{p.colores.length - 4}</span>}</span>}
  {!agotado && p.stock <= 3 && <span class="prod-stock">Quedan {p.stock}</span>}
</a>
