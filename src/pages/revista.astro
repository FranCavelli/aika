---
// Editorial B — Revista: tapa con AIKA gigante sobre la foto, catálogo en grilla asimétrica de revista.
import Tienda from '../layouts/Tienda.astro';
import Logo from '../components/Logo.astro';
import Ui from '../components/Ui.astro';
import Producto from '../components/Producto.astro';
import Filtros from '../components/Filtros.astro';
import { cargarTienda, precio } from '../lib/data';
const { productos, categorias, config: c } = cargarTienda();
const m = c.moneda || '$';
const meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const hoy = new Date();
const destacados = productos.filter(p => p.destacado);
---
<Tienda tema="editorial" titulo="Aika Indu by Cande · Revista">
  <header class="cab marco">
    <Logo tam={0.95} />
    <nav class="nav" aria-label="Principal"><a href="#notas">Destacados</a><a href="#catalogo">Catálogo</a><a href="#sale">Sale</a></nav>
    <button class="icono-btn" data-abrir-bolsa aria-label="Abrir bolsa"><Ui n="bolsa" /><span class="contador" data-contador hidden>0</span></button>
  </header>

  <main>
    <section class="tapa">
      <img src={c.hero_imagen} alt="Look de tapa de la temporada" fetchpriority="high" />
      <p class="cabecera" aria-hidden="true">AIKA</p>
      <div class="tapa-pie marco">
        <p class="fecha">{meses[hoy.getMonth()]} {hoy.getFullYear()}</p>
        <div class="tapa-txt">
          <h1>{c.hero_titulo} <em>{c.hero_script}</em></h1>
          <a class="btn btn-claro" href="#catalogo">Ver catálogo <Ui n="flecha" /></a>
        </div>
      </div>
    </section>

    <section class="notas marco" id="notas">
      <h2>{c.hero_texto}</h2>
      <div class="notas-grid">
        {destacados.slice(0, 3).map((p, i) => (
          <a href={`#${p.id}`} data-producto={p.id} class={`nota nota-${i}`}>
            <img src={p.imagenes[0]} alt={p.nombre} loading="lazy" />
            <span class="nota-tit">{p.nombre}</span>
            <span class="nota-pre">{precio(p.precio, m)}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="sale" id="sale">
      <div class="marco sale-in">
        <h2>{c.promo_titulo}</h2>
        <p>{c.promo_texto}</p>
        <a class="btn btn-claro" href="#catalogo">Ver la sale <Ui n="flecha" /></a>
      </div>
    </section>

    <section class="marco catalogo" id="catalogo" data-catalogo>
      <div class="cat-cab"><h2>Catálogo</h2><div class="cat-f"><Filtros productos={productos} categorias={categorias} /></div></div>
      <div class="grilla">{productos.map(p => <Producto p={p} moneda={m} />)}</div>
      <p class="sin-resultados" data-sin-resultados hidden>No hay prendas con ese filtro por ahora.</p>
    </section>
  </main>

  <footer class="pie">
    <div class="marco pie-in">
      <p class="pie-marca" aria-hidden="true">AIKA</p>
      <div class="pie-datos">
        <p>Envíos a todo el país, gratis desde {precio(Number(c.envio_gratis_desde || 0), m)}.</p>
        <p>Cambios dentro de los 30 días.</p>
        <a href={`https://instagram.com/${c.instagram}`} target="_blank" rel="noopener"><Ui n="insta" /> @{c.instagram}</a>
      </div>
    </div>
  </footer>
</Tienda>

<style>
  .cab{display:flex;align-items:center;justify-content:space-between;height:72px}
  .nav{display:none;gap:32px;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase}
  .nav a{text-decoration:none}
  @media (min-width:800px){.nav{display:flex}}

  .tapa{position:relative;height:calc(100svh - 72px);min-height:560px;overflow:hidden;background:#222;color:#fff}
  .tapa img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 20%;filter:grayscale(1) contrast(1.1) brightness(.85)}
  .cabecera{position:absolute;inset:clamp(24px,4vw,64px) 0 auto;margin:0;font-family:var(--f-titulo);font-size:31vw;line-height:.85;letter-spacing:-.04em;text-align:center;mix-blend-mode:difference;pointer-events:none}
  .tapa-pie{position:absolute;inset:auto 0 0;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:24px;padding-bottom:40px}
  .fecha{font-size:.8rem;letter-spacing:.3em;text-transform:uppercase}
  .tapa-txt{display:flex;flex-direction:column;align-items:flex-start;gap:24px;max-width:560px}
  .tapa h1{font-size:clamp(2.6rem,5.4vw,4.8rem);letter-spacing:-.03em;line-height:.95}
  .tapa em{font-style:italic}
  .btn-claro{border-color:#fff;color:#fff}
  .btn-claro:hover{background:#fff;color:#111}

  .notas{padding-block:120px}
  .notas h2{max-width:22ch;margin-bottom:64px;font-size:clamp(1.8rem,3.4vw,3rem);font-style:italic;line-height:1.15}
  .notas-grid{display:grid;gap:40px 24px}
  @media (min-width:900px){
    .notas-grid{grid-template-columns:repeat(12,1fr);align-items:start}
    .nota-0{grid-column:1/8;grid-row:1/3}
    .nota-1{grid-column:9/13;margin-top:120px}
    .nota-2{grid-column:8/12;margin-top:40px}
  }
  .nota{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;text-decoration:none}
  .nota img{width:100%;aspect-ratio:4/5;object-fit:cover;filter:grayscale(1);transition:filter .6s}
  .nota:hover img{filter:none}
  
  .nota-tit{font-family:var(--f-titulo);font-size:1.5rem}
  .nota-pre{font-size:.9rem;color:var(--tinta-2)}

  .sale{background:var(--tinta);color:var(--fondo)}
  .sale-in{display:grid;gap:24px;align-items:end;padding-block:96px}
  @media (min-width:900px){.sale-in{grid-template-columns:7fr 3fr auto}}
  .sale h2{font-size:clamp(3.4rem,9vw,8rem);letter-spacing:-.04em;line-height:.85}
  .sale p{color:#bdbab3}

  .catalogo{padding-block:120px}
  .cat-cab{display:grid;gap:20px;margin-bottom:48px;padding-bottom:24px;border-bottom:1px solid var(--tinta)}
  @media (min-width:900px){.cat-cab{grid-template-columns:1fr 2fr;align-items:end}}
  .cat-cab h2{font-size:clamp(2.6rem,5vw,4.4rem);letter-spacing:-.03em}
  .cat-f{display:flex;flex-direction:column;gap:10px}
  .grilla{display:grid;grid-template-columns:repeat(2,1fr);gap:40px 16px}
  @media (min-width:900px){.grilla{grid-template-columns:repeat(4,1fr);gap:56px 24px}}

  .pie{background:var(--tinta);color:var(--fondo);overflow:hidden}
  .pie-in{display:flex;flex-direction:column;gap:32px;padding-block:64px 40px}
  .pie-marca{margin:0;font-family:var(--f-titulo);font-size:26vw;line-height:.8;letter-spacing:-.05em}
  .pie-datos{display:flex;flex-wrap:wrap;gap:16px 40px;font-size:.9rem;color:#bdbab3}
  .pie-datos a{display:flex;align-items:center;gap:8px;color:var(--fondo);text-decoration:none}
  .pie-datos :global(svg){width:18px}
</style>
