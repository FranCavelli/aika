---
// Selector de propuestas guardadas (la elegida, Lookbook, es el index).
import '../styles/base.css';
import Logo from '../components/Logo.astro';
import { cargarTienda, ruta } from '../lib/data';
const { config: c } = cargarTienda();
const props = [
  { url: '/editorial', n: 'Editorial', d: 'Blanco y negro como el logo. Media pantalla con la foto fija y la otra mitad con índice y catálogo.', bg: '#111', fg: '#f7f6f3', f: "'Bodoni Moda',serif" },
  { url: '/revista', n: 'Revista', d: 'tapa de revista con AIKA gigante sobre la foto y catálogo en grilla asimétrica.', bg: '#1c1c1c', fg: '#f7f6f3', f: "'Bodoni Moda',serif" },
  { url: '/indice', n: 'Índice', d: 'la tipografía manda. El catálogo es una lista grande; al pasar el mouse aparece la foto.', bg: '#f7f6f3', fg: '#111', f: "'Bodoni Moda',serif" },
  { url: '/lookbook', n: 'Lookbook', d: 'Arena y terracota. La prenda enorme en el inicio y una tira de fotos tipo polaroid.', bg: '#e5d7c5', fg: '#a8502f', f: "'Gloock',serif" },
];
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Aika · Propuestas</title>
<link rel="icon" href={ruta('favicon.svg')} />
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400&family=Cormorant+Garamond:wght@500&family=Gloock&family=Montserrat:wght@400;500&family=Mrs+Saint+Delafield&display=swap" rel="stylesheet" /></head>
<body data-tema="editorial">
  <main class="marco">
    <header><Logo tam={1.6} /><h1>Propuestas para la tienda</h1><p>Todas leen el mismo Excel: cambiás stock, precios o fotos ahí y se actualizan todas.</p></header>
    <ul>
      {props.map(p => (
        <li><a href={ruta(p.url + '/')} style={`--bg:${p.bg};--fg:${p.fg};--f:${p.f}`}>
          <img src={c.hero_imagen} alt="" />
          <span class="nom">{p.n}</span>
          <span class="desc">{p.d}</span>
        </a></li>
      ))}
    </ul>
  </main>
</body></html>
<style>
  main{padding-block:56px 80px}
  header{display:flex;flex-direction:column;gap:20px;margin-bottom:48px}
  h1{font-size:clamp(2.4rem,5vw,4rem);letter-spacing:-.03em}
  header p{max-width:52ch;color:var(--tinta-2)}
  ul{display:grid;gap:24px;margin:0;padding:0;list-style:none}
  @media (min-width:900px){ul{grid-template-columns:repeat(4,1fr)}}
  a{display:flex;flex-direction:column;gap:12px;height:100%;padding:16px 16px 24px;outline:1px solid rgb(0 0 0 / .08);background:var(--bg);color:var(--fg);text-decoration:none;transition:transform .4s cubic-bezier(.2,.8,.2,1)}
  a:hover{transform:translateY(-6px)}
  img{width:100%;aspect-ratio:4/5;object-fit:cover}
  .nom{font-family:var(--f);font-size:2.4rem;line-height:1}
  .desc{font-size:.92rem;opacity:.85}
</style>
